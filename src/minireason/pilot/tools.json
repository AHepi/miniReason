[
  {
    "type": "function",
    "function": {
      "name": "route",
      "description": "Propose one registered template and a concise reason; the host validates suitability before dispatch.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string",
            "enum": [
              "direct_answer",
              "evidence_read",
              "engineer_patch",
              "critic_return",
              "decompose_synthesize"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "template_id",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "spawn",
      "description": "Propose bounded child calls; the host mints IDs and enforces fan-out, depth, custody, and budget.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "subtasks": {
