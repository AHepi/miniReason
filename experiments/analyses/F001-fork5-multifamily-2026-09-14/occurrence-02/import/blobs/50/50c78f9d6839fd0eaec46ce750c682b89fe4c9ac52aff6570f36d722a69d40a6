{"language":"FCL-1","records":[{"id":"r1","type":"claim","text":"The root cause of repeated disputes is lack of clear, documented agreements about chores."},{"id":"r2","type":"claim","text":"Variable work schedules make previously agreed duties harder to keep up, leading to frustration."},{"id":"r3","type":"claim","text":"One friend's avoidance of conversation indicates possible discomfort or burnout with the conflict."},{"id":"r4","type":"problem","text":"How can the household establish a sustainable chore coordination system that accommodates shifting schedules and encourages open communication?"},{"id":"r5","type":"commitment","text":"Create a shared, visible chore calendar (e.g., whiteboard or digital app) where assignments are recorded and can be updated as schedules change.","scope":"household","action":"set up calendar","depends":["r1","r2"]},{"id":"r6","type":"commitment","text":"Hold a brief house meeting within the next week to discuss the new system and express any concerns, ensuring each person has a chance to speak.","scope":"household","action":"schedule meeting","depends":["r3"]},{"id":"r7","type":"use","text":"Use the chore calendar to track completion and adjust responsibilities in real time.","scope":"ongoing","action":"track chores","depends":["r5"]}],"uptake":[]}