{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minireason.local/r002/tested-return.schema.json",
  "title": "R002 return with mandatory check redo (PROPOSED; not shipped)",
  "type": "object",
  "required": [
    "decision",
    "answer",
    "missing_derivation",
    "claims",
    "dispositions",
    "changes",
    "derivation_steps"
  ],
  "properties": {
    "decision": {
      "enum": [
        "answered",
        "cannot_decide"
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "missing_derivation": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "answer.schema.json#/$defs/claim"
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disposition"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "derivation_steps": {
      "type": "array",
      "items": {
        "$ref": "answer.schema.json#/$defs/step"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "cannot_decide"
          }
        }
      },
      "then": {
        "properties": {
          "missing_derivation": {
            "minLength": 1
          },
          "changes": {
            "maxItems": 0
          },
          "dispositions": {
            "items": {
              "properties": {
                "status": {
                  "const": "unresolved"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "missing_derivation": {
            "maxLength": 0
          },
          "claims": {
            "minItems": 1
          },
          "derivation_steps": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "jsonValue": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "array",
        "object",
        "null"
      ]
    },
    "redo": {
      "type": "object",
      "required": [
        "check_id",
        "status",
        "method",
        "result",
        "comparison"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "redone",
            "cannot_redo"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "$ref": "#/$defs/jsonValue"
        },
        "comparison": {
          "enum": [
            "supports_objection",
            "opposes_objection",
            "inconclusive"
          ]
        }
      },
      "additionalProperties": false
    },
    "disposition": {
      "type": "object",
      "required": [
        "id",
        "status",
        "reason",
        "redo",
        "rederivation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "taken-up",
            "rejected-with-reason",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "redo": {
          "$ref": "#/$defs/redo"
        },
        "rederivation": {
          "type": "object",
          "required": [
            "from_step_index",
            "objection_id",
            "status",
            "steps",
            "missing_derivation"
          ],
          "properties": {
            "from_step_index": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "objection_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "rederived",
                "retained",
                "cannot_decide"
              ]
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "answer.schema.json#/$defs/step"
              }
            },
            "missing_derivation": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "rederived"
                  }
                }
              },
              "then": {
                "properties": {
                  "steps": {
                    "minItems": 1
                  },
                  "from_step_index": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "missing_derivation": {
                    "maxLength": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "cannot_decide"
                  }
                }
              },
              "then": {
                "properties": {
                  "missing_derivation": {
                    "minLength": 1
                  },
                  "steps": {
                    "maxItems": 0
                  }
                }
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "taken-up"
              }
            }
          },
          "then": {
            "properties": {
              "rederivation": {
                "properties": {
                  "status": {
                    "const": "rederived"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "required": [
        "relation_id",
        "before_quote",
        "after_quote",
        "changed",
        "direction"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "before_quote": {
          "type": "string"
        },
        "after_quote": {
          "type": "string"
        },
        "changed": {
          "type": "boolean"
        },
        "direction": {
          "enum": [
            "toward_objection",
            "away_from_objection",
            "retained",
            "suspended"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
