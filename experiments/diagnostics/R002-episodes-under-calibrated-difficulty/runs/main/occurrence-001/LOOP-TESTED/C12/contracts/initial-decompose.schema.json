{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minireason.local/r002/initial-decompose.schema.json",
  "title": "R002 bounded initial decomposition response",
  "type": "object",
  "required": ["plan", "first_step", "cannot_decide"],
  "properties": {
    "plan": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/planStep"}
    },
    "first_step": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/stepResult"}
      ]
    },
    "cannot_decide": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["missing"],
          "properties": {"missing": {"type": "string", "minLength": 1, "maxLength": 2000}},
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"cannot_decide": {"type": "null"}}},
      "then": {
        "properties": {
          "plan": {"minItems": 1},
          "first_step": {"$ref": "#/$defs/stepResult"}
        }
      },
      "else": {
        "properties": {
          "plan": {"maxItems": 0},
          "first_step": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "planStep": {
      "type": "object",
      "required": ["step", "goal", "depends_on"],
      "properties": {
        "step": {"type": "integer", "minimum": 1, "maximum": 8},
        "goal": {"type": "string", "minLength": 1, "maxLength": 256},
        "depends_on": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 8},
          "uniqueItems": true,
          "maxItems": 7
        }
      },
      "additionalProperties": false
    },
    "stepResult": {
      "type": "object",
      "required": ["step", "derivation", "result"],
      "properties": {
        "step": {"const": 1},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 2000},
        "result": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
