{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minireason.local/r002/decomposed-step.schema.json",
  "title": "R002 bounded later decomposition step response",
  "type": "object",
  "required": ["step", "derivation", "result", "cannot_decide"],
  "properties": {
    "step": {"type": "integer", "minimum": 2, "maximum": 8},
    "derivation": {"type": "string", "maxLength": 2000},
    "result": {"type": "string", "maxLength": 512},
    "cannot_decide": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["missing"],
          "properties": {"missing": {"type": "string", "minLength": 1, "maxLength": 2000}},
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"cannot_decide": {"type": "null"}}},
      "then": {
        "properties": {
          "derivation": {"minLength": 1},
          "result": {"minLength": 1}
        }
      },
      "else": {
        "properties": {
          "derivation": {"maxLength": 0},
          "result": {"maxLength": 0}
        }
      }
    }
  ],
  "additionalProperties": false
}
