{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minireason.local/r003/canonical-registry.schema.json",
  "title": "R003 occurrence-local canonical problem registry",
  "type": "object",
  "required": ["schema_version", "study_profile", "candidates"],
  "properties": {
    "schema_version": {"const": "minireason.reason.r003-canonical-registry.v1"},
    "study_profile": {"const": "r003-open-v1"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["candidate_id", "canonical_problem", "problem_sha256"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^O0[1-8]$"},
          "canonical_problem": {"type": "string", "pattern": "^p/O0[1-8]\\.txt$"},
          "problem_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
