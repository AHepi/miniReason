{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minireason.local/r003/forks.schema.json",
  "title": "R003 participant-located public forks",
  "type": "object",
  "required": ["schema_version", "status", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "DRAFT_REQUIRES_OPEN_PROBLEM_ADMISSION"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["candidate_id", "branch_points", "note"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^O0[1-8]$"},
          "branch_points": {"type": "array", "maxItems": 0},
          "note": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
